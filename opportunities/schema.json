{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opportunity",
  "type": "object",
  "required": ["id", "name", "category", "decision", "score", "evidence", "next_action"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "category": {"type": "string"},
    "decision": {"enum": ["build", "research", "hold", "reject"]},
    "score": {"type": "number", "minimum": 0, "maximum": 100},
    "decision_rationale": {"type": "string"},
    "product_path": {"enum": ["create", "source", "modify", "unknown"]},
    "target_price": {"type": ["number", "null"], "minimum": 0},
    "marketplace": {"type": ["string", "null"]},
    "next_action": {"type": "string"},
    "blocked_reasons": {"type": "array", "items": {"type": "string"}},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "url", "observed_at", "signal", "value"],
        "properties": {
          "source": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "observed_at": {"type": "string"},
          "signal": {"type": "string"},
          "value": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 100}
    }
  }
}
